# Copy to .env (never commit .env). Only DATABASE_URL is required.
# Local Docker database (docker compose up -d db):
DATABASE_URL=postgres://deanery:deanery-local-only@127.0.0.1:5433/deanery
# Hosted (Neon via the Vercel Marketplace): paste the pooled connection string, e.g.
# DATABASE_URL=postgres://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require

# Password for the fictional demo accounts, used by `npm run db:setup` and shown in «Демо-входы».
# Default when unset: DeaneryDemo2026
# DEANERY_DEMO_PASSWORD=DeaneryDemo2026

# Set to true behind HTTPS (Vercel) so the session cookie is Secure.
COOKIE_SECURE=false
